# Server-only — never expose these with a NEXT_PUBLIC_ prefix, the browser must never see them.
BACKEND_API_URL=http://192.168.1.34:8000/api/v1
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Client-side — used by the Patrollings live-tracking map. Needs a Google
# Cloud API key with the "Maps JavaScript API" enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
